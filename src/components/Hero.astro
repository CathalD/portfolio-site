---
/*
 * Hero — the full-bleed home page header.
 *
 * Used by: /index.astro. Nothing else.
 *
 * ACCESSIBILITY NOTE, and the reason this looks heavier than it needs to:
 * the heading sits over a photograph, so its contrast depends on an image
 * nobody has chosen yet. The scrim is therefore a SOLID colour at a fixed
 * opacity rather than a gradient. A solid scrim has one worst case — the
 * scrim over pure white — and `npm run check:a11y` verifies the text against
 * exactly that. A gradient has a different contrast ratio at every pixel and
 * cannot be verified at all, which is why the spec for this site rules them
 * out. If you swap in a darker photograph the ratio only improves.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  /** Describe the photograph. Never repeat the heading text here. */
  imageAlt: string;
  heading: string;
  /** The lead line, set larger. */
  statement: string;
  /** The line under the statement, set smaller. */
  subtitle?: string;
}

const { image, imageAlt, heading, statement, subtitle } = Astro.props;
---

<section class="relative isolate border-b border-rule">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1440, 1920, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="h-[62vh] max-h-[40rem] min-h-[24rem] w-full rounded-none border-0 object-cover"
  />

  <!--
    The scrim. `aria-hidden` because it carries no meaning; the opacity comes
    from --scrim-opacity in theme.css so that check:a11y and the browser are
    reading the same number.
  -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-0 bg-scrim"
    style="opacity: var(--scrim-opacity)"
  >
  </div>

  <div class="absolute inset-0 flex items-end">
    <div class="mx-auto w-full max-w-[var(--measure-wide)] px-5 pb-10 sm:px-8 sm:pb-14">
      <h1 class="text-4xl font-semibold tracking-tight text-on-scrim sm:text-5xl">
        {heading}
      </h1>

      <p class="mt-5 max-w-[46rem] text-lg leading-relaxed text-on-scrim sm:text-xl">
        {statement}
      </p>

      {
        subtitle && (
          <p class="mt-4 font-sans text-sm text-on-scrim-muted sm:text-base">{subtitle}</p>
        )
      }
    </div>
  </div>
</section>
