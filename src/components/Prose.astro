---
/*
 * Prose — typographic styling for rendered Markdown.
 *
 * Used by: ProseLayout, and anywhere else `<Content />` is rendered.
 *
 * These styles are written by hand rather than pulled from a typography
 * plugin. That is a deliberate trade: one fewer dependency, and complete
 * control over a measure and vertical rhythm that are the whole point of the
 * design. The cost is that new Markdown elements need a rule adding here.
 *
 * The styles are global rather than scoped because the HTML they target comes
 * from Astro's Markdown renderer via <slot />, which never carries this
 * component's scoping attribute. They are namespaced under `.prose` so they
 * cannot leak.
 */

interface Props {
  /** Extra classes for the wrapper. */
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style is:global>
  .prose {
    max-width: var(--measure);
  }

  /* Vertical rhythm: space comes from the top of the following element, so
     the first child never pushes the article away from its heading. */
  .prose > * + * {
    margin-block-start: 1.1em;
  }

  .prose > h2 {
    margin-block-start: 2.4em;
    font-size: 1.45em;
    letter-spacing: -0.01em;
  }

  .prose > h3 {
    margin-block-start: 1.9em;
    font-size: 1.18em;
  }

  .prose > h4 {
    margin-block-start: 1.6em;
    font-size: 1.02em;
    font-weight: 600;
  }

  /* Anchor targets for the table of contents (Stage 2) land on headings. */
  .prose :is(h2, h3, h4) {
    scroll-margin-block-start: 2rem;
  }

  .prose :is(ul, ol) {
    padding-inline-start: 1.4em;
  }

  .prose ul {
    list-style-type: square;
  }

  .prose li + li {
    margin-block-start: 0.4em;
  }

  .prose li::marker {
    color: var(--color-ink-faint);
  }

  .prose blockquote {
    margin-inline: 0;
    padding-inline-start: 1.2em;
    border-inline-start: 2px solid var(--color-rule-strong);
    color: var(--color-ink-muted);
    font-style: italic;
  }

  .prose :not(pre) > code {
    padding: 0.1em 0.35em;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background-color: var(--color-surface);
    font-size: 0.875em;
    /* Keep long identifiers from forcing a horizontal scrollbar. */
    overflow-wrap: break-word;
  }

  .prose pre {
    padding: 1em 1.1em;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.875em;
    line-height: 1.55;
    /* Shiki sets its own background; keep it inside the border. */
    background-color: var(--color-surface) !important;
  }

  .prose img,
  .prose video {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .prose figure > figcaption {
    margin-block-start: 0.6em;
    color: var(--color-ink-muted);
    font-family: var(--font-sans);
    font-size: 0.85em;
    line-height: 1.5;
  }

  .prose hr {
    margin-block: 2.6em;
  }

  /* Tables scroll inside their own container rather than widening the page. */
  .prose table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.9em;
  }

  .prose :is(th, td) {
    padding: 0.5em 0.9em 0.5em 0;
    border-block-end: 1px solid var(--color-rule);
    text-align: start;
    vertical-align: top;
  }

  .prose th {
    border-block-end-color: var(--color-rule-strong);
    font-weight: 600;
  }

  /* Footnotes, as generated by remark-gfm. */
  .prose .footnotes {
    margin-block-start: 3em;
    padding-block-start: 1.2em;
    border-block-start: 1px solid var(--color-rule);
    font-size: 0.9em;
    color: var(--color-ink-muted);
  }
</style>
