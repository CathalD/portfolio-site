---
/* /gallery — published media. Originals stay outside the repository. */
import CollectionLayout from '../../layouts/CollectionLayout.astro';
import GalleryCard from '../../components/GalleryCard.astro';
import { getPublished, byDateDesc } from '../../lib/content.ts';

const items = byDateDesc(await getPublished('gallery'), (entry) => entry.data.capturedAt);
---

<CollectionLayout
  title="Gallery"
  description="Photographs."
  count={items.length}
  emptyMessage="No gallery items have been published yet."
>
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((entry) => <GalleryCard entry={entry} />)}
  </div>
</CollectionLayout>
